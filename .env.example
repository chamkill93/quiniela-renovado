APP_URL=http://localhost:3000
# El valor exacto "false" publica el frontend sin la pantalla DEV; requiere un nuevo build.
DEV_ACCESS_REQUIRED=true
# Acceso previo al entorno DEV. Cambiá ambos valores fuera de una demo local.
DEV_ACCESS_CODE="Admin123#"
DEV_ACCESS_COOKIE_SECRET=
# Solo desarrollo/QA. En producción la variable debe ser explícita y normalmente "backoffice".
NEXT_PUBLIC_PRODUCT_GATEWAY_MODE=preview
NEXT_PUBLIC_BACKOFFICE_BASE_URL=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_SESSION=
# Opcional: compatibilidad con proveedores que además publican un bootstrap monolítico.
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_BOOTSTRAP=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_LOGIN=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_REGISTER=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_LOGOUT=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_CATALOG=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_PLAYS=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_TRADITIONAL_PLAYS=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_INSTANT_PLAYS=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_RESULTS=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_TICKET=
NEXT_PUBLIC_BACKOFFICE_TIMEOUT_MS=15000
# Opcionales: la billetera solo se habilita si ambos están configurados.
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_WALLET_MOVEMENTS=
NEXT_PUBLIC_BACKOFFICE_ENDPOINT_WALLET_TOPUP=

# Opcionales: fuentes HTTPS autorizadas para las páginas públicas de sorteos.
# Si una URL queda vacía o no es HTTPS, la interfaz muestra el placeholder seguro.
NEXT_PUBLIC_DRAW_STREAM_TEMPRANERO_URL=
NEXT_PUBLIC_DRAW_STREAM_MATUTINO_URL=
NEXT_PUBLIC_DRAW_STREAM_VESPERTINO_URL=
NEXT_PUBLIC_DRAW_STREAM_NOCTURNO_URL=

# Opcional: número oficial de atención de WhatsApp con código de país (solo dígitos).
# Vacío o inválido: Cuenta muestra el canal como pendiente, sin enlazar a otro número.
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=
