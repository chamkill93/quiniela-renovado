generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
  OPERATOR
}

enum BetStatus {
  PENDING
  ACCEPTED
  REJECTED
  SETTLED
  CANCELLED
}

enum LedgerType {
  CREDIT
  DEBIT
  BET
  STAKE_REFUND
  PRIZE
  ADJUSTMENT
}

enum DrawStatus {
  OPEN
  CLOSING
  CLOSED
  RESULTED
  CANCELLED
}

enum ProviderMode {
  MOCK
  UAT
  PROD
}

model User {
  id String @id @default(cuid())
  document String? @unique
  phone String? @unique
  email String? @unique
  displayName String
  passwordHash String
  role UserRole @default(PLAYER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  wallet Wallet?
  bets Bet[]
  consents UserConsent[]
  auditLogs AuditLog[] @relation("AuditActor")
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  ipHash String?
  userAgent String? @db.Text
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
}

model Wallet {
  id String @id @default(cuid())
  userId String @unique
  currency String @default("PYG")
  balanceMinor BigInt @default(0)
  version Int @default(0)
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  entries WalletEntry[]
}

model WalletEntry {
  id String @id @default(cuid())
  walletId String
  type LedgerType
  amountMinor BigInt
  balanceAfterMinor BigInt
  referenceType String?
  referenceId String?
  note String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields:[walletId],references:[id],onDelete:Cascade)
  @@index([walletId,createdAt])
  @@index([referenceType,referenceId])
}

model Game {
  id String @id
  name String
  family String
  enabled Boolean @default(true)
  sortOrder Int @default(0)
  config Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bets Bet[]
}

model Draw {
  id String @id @default(cuid())
  externalId String? @unique
  name String
  region String?
  closesAt DateTime
  drawsAt DateTime
  status DrawStatus @default(OPEN)
  resultThreeDigits Int?
  providerPayload Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bets Bet[]
}

model Bet {
  id String @id @default(cuid())
  userId String
  gameId String
  drawId String?
  clientRequestId String @unique
  providerTransactionId String? @unique
  status BetStatus @default(PENDING)
  currency String @default("PYG")
  stakeMinor BigInt
  prizeMinor BigInt @default(0)
  selection Json
  result Json?
  providerMode ProviderMode @default(MOCK)
  createdAt DateTime @default(now())
  settledAt DateTime?
  user User @relation(fields:[userId],references:[id])
  game Game @relation(fields:[gameId],references:[id])
  draw Draw? @relation(fields:[drawId],references:[id])
  ticket Ticket?
  @@index([userId,createdAt])
  @@index([gameId,createdAt])
}

model Ticket {
  id String @id @default(cuid())
  betId String @unique
  code String @unique
  payload Json
  createdAt DateTime @default(now())
  bet Bet @relation(fields:[betId],references:[id],onDelete:Cascade)
}

model IdempotencyRecord {
  key String @id
  userId String
  route String
  requestHash String
  responseCode Int?
  responseBody Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}

model ProviderRequest {
  id String @id @default(cuid())
  provider String
  mode ProviderMode
  operation String
  correlationId String @unique
  requestMeta Json?
  responseMeta Json?
  httpStatus Int?
  durationMs Int?
  ok Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([operation,createdAt])
}

model LegalDocument {
  id String @id
  title String
  version String
  type String
  contentHtml String @db.LongText
  active Boolean @default(true)
  publishedAt DateTime @default(now())
  consents UserConsent[]
}

model UserConsent {
  id String @id @default(cuid())
  userId String
  legalDocumentId String
  acceptedAt DateTime @default(now())
  ipHash String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  document LegalDocument @relation(fields:[legalDocumentId],references:[id])
  @@unique([userId,legalDocumentId])
}

model FeatureFlag {
  key String @id
  enabled Boolean @default(false)
  config Json?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())
  actorUserId String?
  action String
  entityType String
  entityId String?
  meta Json?
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor",fields:[actorUserId],references:[id])
  @@index([entityType,entityId])
  @@index([createdAt])
}
